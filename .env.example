# Copy to .env and fill in. Never commit .env.
# Generate secrets with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- required in production -------------------------------------------
TROVE_DOMAIN=trove.example.com
TROVE_PUBLIC_ORIGIN=https://trove.example.com
POSTGRES_PASSWORD=change-me-long-random
TROVE_VAULT_KEY=
TROVE_PEPPER=

# --- accounts -----------------------------------------------------------
TROVE_ALLOW_SIGNUP=true
TROVE_SEPARATE_REVIEWER=true

# --- notifications (TROVE_NOTIFIER=live in production) -------------------
TROVE_NOTIFIER=live
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Trove <no-reply@example.com>
# SMS via Twilio ...
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# ... or any HTTPS SMS gateway
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# --- models -------------------------------------------------------------
# Local encoder (no per-call cost). "hashing" = no model download.
TROVE_ENCODER=fastembed
TROVE_ENCODER_MODEL=BAAI/bge-small-en-v1.5
# Optional generative LLM, used only when the user ticks consent:
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- connectors ---------------------------------------------------------
# Folder/USB/NAS scanning is limited to this directory (mounted read-only)
TROVE_IMPORT_ROOT=/data/import

TROVE_LOG_LEVEL=INFO

# --- Country rules / data residency ---------------------------------------
# Region this deployment stores data in (in, uk, us, eu). Shown on the compliance page.
TROVE_DATA_REGION=
# 1 = refuse cases whose country should be hosted in another region (run one deployment per region)
TROVE_ENFORCE_RESIDENCY=0
