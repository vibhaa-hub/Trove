# Automatic HTTPS (Let's Encrypt) in front of the Trove web container.
{$TROVE_DOMAIN} {
	encode gzip
	request_body {
		max_size 15MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy web:8000 {
		header_up X-Request-ID {http.request.uuid}
	}
	log {
		output stdout
		format json
	}
}
